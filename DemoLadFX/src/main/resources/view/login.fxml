      <Pane layoutX="20.0" layoutY="153.0" prefHeight="42.0" prefWidth="280.0" style="-fx-border-color: black; -fx-border-radius: 2;" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0">
